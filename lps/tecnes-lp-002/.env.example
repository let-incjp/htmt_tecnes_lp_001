# 計測タグ用の各種ID。
# 未設定の間はAnalyticsScripts（src/components/AnalyticsScripts.tsx）が
# 何も出力しないため、ベースコードは読み込まれない。
# Vercelの環境変数に値を入れるだけで有効になる。
#
# TikTok / GA4 は src/lib/constants.ts に既定値を設定済み。
# 変更したい場合のみ、ここで上書きできる。
# このLP(tecnes-lp-002)はMeta Pixelを設置しない
# （Meta広告はtecnes-lp-004-metaで計測する）。
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
